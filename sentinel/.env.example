# ── SENTINEL Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql+asyncpg://sentinel:change_me_strong_password@localhost:5432/sentinel
DATABASE_URL_SYNC=postgresql://sentinel:change_me_strong_password@localhost:5432/sentinel

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── SEC EDGAR ───────────────────────────────────────────────────────────────
# Required by SEC: "Name email@domain.com" format
EDGAR_USER_AGENT=Sentinel richard.porras@realempanada.com

# ── Free API Keys ───────────────────────────────────────────────────────────
# FRED (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub (free tier): https://finnhub.io/register
FINNHUB_API_KEY=

# Alpha Vantage (free 5/min): https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# OpenFIGI (free, required for instrument mastering): https://www.openfigi.com/api
OPENFIGI_API_KEY=

# Polygon.io (free delayed, $29/mo real-time): https://polygon.io
POLYGON_API_KEY=

# Etherscan (free 5 calls/sec): https://etherscan.io/apis
ETHERSCAN_API_KEY=

# ── Broker Credentials ──────────────────────────────────────────────────────
# Alpaca (free paper trading): https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Set to "paper" for paper trading, "live" for live trading
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Interactive Brokers — credentials managed via IB Gateway / TWS
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# ── AI / Embedding ──────────────────────────────────────────────────────────
# Anthropic Claude (NL-to-strategy, document intelligence)
ANTHROPIC_API_KEY=

# Voyage AI (financial embeddings — voyage-finance-2)
VOYAGE_API_KEY=

# ── Safety Switches ─────────────────────────────────────────────────────────
# MUST be "true" to enable live trading. Paper trading is always on.
SENTINEL_LIVE_TRADING=false

# ── Monitoring ──────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change_me

# ── Optional Paid Upgrades ───────────────────────────────────────────────────
# Financial Modeling Prep (250 calls/day free): https://financialmodelingprep.com
FMP_API_KEY=

# EODHD ($19.99/mo): https://eodhistoricaldata.com
EODHD_API_KEY=

# Reddit PRAW (free): https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentinel:v0.1 (by u/your_username)

# Glassnode (free tier on-chain): https://glassnode.com
GLASSNODE_API_KEY=

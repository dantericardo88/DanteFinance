# SENTINEL Environment Variables — copy to .env and fill in your keys
# Never commit .env to git!

# ─── Database ─────────────────────────────────────────────────────────────────
# Async driver (used by FastAPI + all runtime code)
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_dev_password@localhost:5432/sentinel
# Sync driver (used by Alembic migrations only — psycopg2)
DATABASE_URL_SYNC=postgresql://sentinel:sentinel_dev_password@localhost:5432/sentinel
POSTGRES_PASSWORD=sentinel_dev_password
REDIS_URL=redis://localhost:6379

# ─── Free Data APIs ───────────────────────────────────────────────────────────
# FRED — free with registration: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub — free tier: https://finnhub.io/register
FINNHUB_API_KEY=

# Alpha Vantage — free tier: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# OpenFIGI — free, 25K/min: https://www.openfigi.com/api
OPENFIGI_API_KEY=

# ─── Market Data (Paid but affordable) ────────────────────────────────────────
# Polygon — Starter $29/mo: https://polygon.io/dashboard/signup
POLYGON_API_KEY=

# ─── Execution ────────────────────────────────────────────────────────────────
# Alpaca — free paper trading, $0 commission live: https://alpaca.markets/
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Interactive Brokers — optional, for TWS integration
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# ─── AI Layer ─────────────────────────────────────────────────────────────────
# Anthropic — for MCP server AI tools: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Voyage AI — for financial embeddings (optional, falls back to sentence-transformers)
VOYAGE_API_KEY=

# ─── EDGAR ────────────────────────────────────────────────────────────────────
# Must be in format: "YourName your@email.com" — required by SEC
EDGAR_USER_AGENT=SENTINEL sentinel@example.com

# ─── Trading Safety Gate ──────────────────────────────────────────────────────
# NEVER set to true unless you understand the implications of live automated trading
SENTINEL_LIVE_TRADING=false

# ─── Application Config ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
PROD_MODE=false
MCP_PORT=8001
API_PORT=8000
TERMINAL_PORT=8501
